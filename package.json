{
  "name": "haggle",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@>=1.0.0 <1.19.10": "1.19.17",
      "axios@>=1.0.0 <1.16.0": "1.19.0",
      "browserslist@<4.28.7": "4.28.8",
      "express-rate-limit@>=8.0.0 <8.2.2": "8.6.2",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "find-my-way@>=9.0.0 <9.7.0": "9.9.0",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "hono@>=4.0.0 <4.12.25": "4.13.3",
      "ip-address@>=10.0.0 <10.3.1": "10.5.0",
      "nanoid@<3.3.18": "3.3.18",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.2",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "postcss@<=8.5.17": "8.5.18",
      "sharp@>=0.30.0 <0.35.0": "0.35.3",
      "shell-quote@>=1.0.0 <1.9.0": "1.10.0",
      "socket.io-parser@>=4.0.0 <4.2.7": "4.2.7",
      "ws@>=7.0.0 <7.5.11": "7.5.13",
      "ws@>=8.0.0 <8.21.0": "8.21.3"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "turbo test",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "verify:migrations": "node scripts/verify-drizzle-journal.mjs && pnpm verify:db-schema",
    "verify:db-schema": "node scripts/verify-db-schema-ownership.mjs && node scripts/verify-transaction-relations.mjs && pnpm --filter @haggle/db db:check",
    "verify:db-invariants": "node scripts/verify-db-invariants.mjs",
    "audit:prod": "node scripts/audit-production-dependencies.mjs",
    "work:me": "node scripts/query-weekly-work-graph.mjs",
    "db:preflight:compat": "pnpm --filter @haggle/db db:preflight:compat",
    "db:audit:relations": "pnpm --filter @haggle/db db:audit:relations",
    "db:prod:migrate:check": "node scripts/apply-production-db-migrations.mjs",
    "db:prod:migrate:apply": "node scripts/apply-production-db-migrations.mjs --apply",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test smoke.spec.ts",
    "test:e2e:transaction": "playwright test two-account-transaction-rehearsal.spec.ts --headed --workers=1",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "next": "^15.5.21",
    "playwright": "^1.60.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  }
}
