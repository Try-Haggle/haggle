{
  "name": "@haggle/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "pnpm build && drizzle-kit generate",
    "db:generate:custom": "pnpm build && drizzle-kit generate --custom",
    "db:check": "pnpm build && drizzle-kit check",
    "db:report:precedent-readiness": "node scripts/report-dispute-precedent-readiness.mjs",
    "db:report:precedent-convergence": "node scripts/report-dispute-precedent-convergence.mjs",
    "db:test:precedent-convergence": "node --test scripts/dispute-precedent-convergence.test.mjs",
    "db:test:precedent-readiness": "node --test scripts/dispute-precedent-readiness.test.mjs",
    "db:preflight:compat": "node scripts/preflight-existing-table-compatibility.mjs",
    "db:audit:relations": "node scripts/audit-transaction-relations.mjs",
    "db:migrate": "pnpm build && pnpm db:preflight:compat && drizzle-kit migrate && pnpm db:audit:relations",
    "db:push": "pnpm build && drizzle-kit push",
    "db:studio": "pnpm build && drizzle-kit studio"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@haggle/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  }
}
