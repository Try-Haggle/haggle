{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!**/node_modules",
      "!**/.turbo",
      "!**/coverage",
      "!**/*.gen.ts",
      "!packages/contracts/out",
      "!packages/contracts/cache",
      "!packages/db/drizzle",
      "!docs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "useArrowFunction": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "useImportType": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/app/(marketing)/landing.css"],
      "linter": {
        "rules": {
          "style": { "noDescendingSpecificity": "off" },
          "suspicious": {
            "noEmptyBlock": "off",
            "noShorthandPropertyOverrides": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/app/(marketing)/landing.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off",
            "useButtonType": "off",
            "useValidAnchor": "off"
          },
          "suspicious": { "useIterableCallbackReturn": "off" }
        }
      }
    }
  ]
}
