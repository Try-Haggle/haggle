NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[ANON-KEY]
NEXT_PUBLIC_API_URL=https://api.tryhaggle.ai
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_WS_URL=wss://api.tryhaggle.ai

# URL where the marketing landing page (tryhaggle.ai) is reachable.
# Local: http://localhost:3002
# Prod:  https://tryhaggle.ai
NEXT_PUBLIC_LANDING_URL=https://tryhaggle.ai

# Dogfood auth (staging/local only — never set on production web).
# Server-only; do NOT prefix with NEXT_PUBLIC_. ≥32 bytes required for BFF mint.
# HAGGLE_ENV=local
# HAGGLE_DOGFOOD_AUTH_SECRET=
