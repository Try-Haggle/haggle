# ─── Database ────────────────────────────────────────────
# Use Session Pooler URL for IPv4 compatibility
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ─── Server ──────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production
# Production cannot start in local mode. Generate a dedicated secret with:
# openssl rand -hex 32
HAGGLE_API_RATE_LIMIT_MODE=postgres
HAGGLE_API_RATE_LIMIT_HMAC_SECRET=

# ─── Auth ────────────────────────────────────────────────
# Supabase JWT secret — REQUIRED in production. Found in Supabase dashboard > Settings > API
JWT_SECRET=your-supabase-jwt-secret
# API defaults to Supabase JWKS verification in staging/production.
HAGGLE_SUPABASE_JWT_MODE=jwks
SUPABASE_JWT_AUDIENCE=authenticated
# Deprecated migration mode only: HAGGLE_SUPABASE_JWT_MODE=legacy_hs256
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Explicit local dashboard fixture mode only; forbidden in staging/production.
HAGGLE_ALLOW_UNVERIFIED_TEST_JWT=false

# ─── Public App URL (for share links) ──────────────────
PUBLIC_APP_URL=https://tryhaggle.ai
PUBLIC_API_URL=https://api.tryhaggle.ai

# ─── Supabase Storage ───────────────────────────────────
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[SERVICE-ROLE-KEY]

# ─── Payments: Stripe Onramp (fiat → USDC) ──────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe onramp crypto destination wallet
STRIPE_ONRAMP_DESTINATION_WALLET=

# ─── Payments: x402 (Base L2 + USDC) ────────────────────
HAGGLE_X402_MODE=mock
HAGGLE_X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
HAGGLE_X402_NETWORK=base
HAGGLE_X402_WALLET_NETWORK=eip155:8453
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
HAGGLE_X402_USDC_ASSET_ADDRESS=USDC
HAGGLE_BASE_RPC_URL=
HAGGLE_CONDITIONAL_SETTLEMENT_CONFIRMATIONS=2
HAGGLE_CONDITIONAL_SETTLEMENT_PENDING_SLA_SECONDS=120
HAGGLE_SETTLEMENT_ROUTER_ADDRESS=
HAGGLE_DISPUTE_REGISTRY_ADDRESS=
HAGGLE_ROUTER_RELAYER_PRIVATE_KEY=
HAGGLE_X402_FEE_BPS=250
HAGGLE_X402_DEFAULT_BUYER_AUTH_MODE=human_wallet
HAGGLE_X402_FEE_WALLET=0xYOUR_HAGGLE_FEE_WALLET
HAGGLE_X402_SELLER_WALLET_MAP={}
HAGGLE_X402_BUYER_WALLET_MAP={}

# ─── Webhook Secrets ──────────────────────────────────────
# Generate with: openssl rand -hex 32
HAGGLE_X402_WEBHOOK_SECRET=
EASYPOST_WEBHOOK_SECRET=
SHIPPING_RATE_MAX_MISSES_PER_MINUTE=30
SHIPPING_RATE_CACHE_MAX_ENTRIES=5000

# ─── Notifications (Resend) ──────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Production: notifications@tryhaggle.ai (requires domain verification in Resend)
RESEND_WEBHOOK_SECRET=
# Generate with: openssl rand -base64 32
NOTIFICATION_UNSUBSCRIBE_SECRET=

# ─── LLM Negotiation Engine ──────────────────────────────
# Real negotiation always runs through the staged LLM pipeline; there is no
# rule-based fallback. NEGOTIATION_ENGINE is no longer read at runtime.
# xAI API key for Grok 4 Fast — REQUIRED for real negotiations.
XAI_API_KEY=
XAI_MODEL=grok-4-fast
# Telemetry: '0' disabled, '1' stdout, 'db' stdout + DB persist
LLM_TELEMETRY=0

# DeepSeek dispute AI output budgets. Resolution needs room for model reasoning
# plus the final structured judgment JSON.
DISPUTE_AI_CASE_GUIDE_MAX_TOKENS=1600
DISPUTE_AI_RESOLUTION_ASSESSOR_MAX_TOKENS=4096
# Base64 DER PKCS#8 Ed25519 private key for signed AI audit exports.
DISPUTE_AUDIT_SIGNING_PRIVATE_KEY_BASE64=
# Optional external malware scanner. URL and token must be set together.
# Evidence remains quarantined until the scanner returns CLEAN.
# The endpoint receives the raw file body.
DISPUTE_EVIDENCE_SCANNER_URL=
DISPUTE_EVIDENCE_SCANNER_TOKEN=
DISPUTE_EVIDENCE_SCANNER_TIMEOUT_MS=15000
# Local fixture only. Both overrides are forbidden in production.
DISPUTE_EVIDENCE_SCANNER_ALLOW_INSECURE_HTTP=false
DISPUTE_EVIDENCE_SCANNER_ALLOW_PRIVATE_NETWORK=false
# Distributed retry worker. Requires ENABLE_CRON=true and a configured scanner.
ENABLE_DISPUTE_EVIDENCE_SCAN_RETRY_JOB=false
DISPUTE_EVIDENCE_SCAN_RETRY_BATCH_SIZE=10
DISPUTE_EVIDENCE_SCAN_RETRY_MAX_ATTEMPTS=5
DISPUTE_EVIDENCE_SCAN_RETRY_LEASE_SECONDS=60
DISPUTE_EVIDENCE_SCAN_RETRY_BASE_BACKOFF_SECONDS=30
DISPUTE_EVIDENCE_SCAN_RETRY_MAX_BACKOFF_SECONDS=3600
# Signed aggregate alert for stale, exhausted, expired, or backed-up scans.
ENABLE_DISPUTE_EVIDENCE_SCAN_RETRY_ALERT_JOB=false
DISPUTE_EVIDENCE_SCAN_RETRY_ALERT_URL=
DISPUTE_EVIDENCE_SCAN_RETRY_ALERT_SECRET=
DISPUTE_EVIDENCE_SCAN_RETRY_ALERT_PREVIOUS_SECRETS=
DISPUTE_EVIDENCE_SCAN_RETRY_ALERT_TIMEOUT_MS=5000
DISPUTE_EVIDENCE_SCAN_RETRY_ALERT_COOLDOWN_MINUTES=15
DISPUTE_EVIDENCE_SCAN_RETRY_ALERT_RETRY_READY_THRESHOLD=10
DISPUTE_EVIDENCE_SCAN_RETRY_ALERT_STALE_THRESHOLD=1
DISPUTE_EVIDENCE_SCAN_RETRY_ALERT_EXHAUSTED_THRESHOLD=1
DISPUTE_EVIDENCE_SCAN_RETRY_ALERT_EXPIRED_THRESHOLD=1
DISPUTE_EVIDENCE_SCAN_RETRY_ALERT_RETENTION_BLOCKED_THRESHOLD=1
DISPUTE_EVIDENCE_SCAN_RETRY_ALERT_ALLOW_INSECURE_HTTP=false
DISPUTE_EVIDENCE_SCAN_RETRY_ALERT_ALLOW_PRIVATE_NETWORK=false
# OCR/vision endpoint that verifies the session challenge in camera evidence.
DISPUTE_CAMERA_CHALLENGE_VERIFIER_URL=
DISPUTE_CAMERA_CHALLENGE_VERIFIER_TOKEN=
# Evidence lifecycle. The deletion job must be explicitly enabled.
ENABLE_DISPUTE_EVIDENCE_RETENTION_JOB=false
DISPUTE_EVIDENCE_RETENTION_DAYS=90
DISPUTE_EVIDENCE_ORPHAN_RETENTION_DAYS=7
DISPUTE_EVIDENCE_RETENTION_BATCH_SIZE=50
# Provider webhook processing lease; active handlers renew it by heartbeat.
WEBHOOK_EVENT_CLAIM_LEASE_SECONDS=60
# Signed ops alert for stale/failed provider webhook claims. Requires ENABLE_CRON=true.
ENABLE_WEBHOOK_CLAIM_HEALTH_ALERT_JOB=false
WEBHOOK_CLAIM_ALERT_URL=
WEBHOOK_CLAIM_ALERT_SECRET=
# Receiver rotation: comma-separated previous secrets; current + previous total <= 4, each 16..128 chars, no duplicates.
WEBHOOK_CLAIM_ALERT_PREVIOUS_SECRETS=
WEBHOOK_CLAIM_ALERT_TIMEOUT_MS=5000
WEBHOOK_CLAIM_ALERT_COOLDOWN_MINUTES=15
WEBHOOK_CLAIM_ALERT_FAILED_THRESHOLD=1
WEBHOOK_CLAIM_ALERT_STALE_THRESHOLD=1
WEBHOOK_CLAIM_ALERT_RETRY_READY_THRESHOLD=1
# Signed aggregate alert for expired APV payout reservations. Requires ENABLE_CRON=true.
ENABLE_SHIPMENT_APV_PAYOUT_ALERT_JOB=false
SHIPMENT_APV_PAYOUT_ALERT_URL=
SHIPMENT_APV_PAYOUT_ALERT_SECRET=
SHIPMENT_APV_PAYOUT_ALERT_TIMEOUT_MS=5000
SHIPMENT_APV_PAYOUT_ALERT_COOLDOWN_MINUTES=15
SHIPMENT_APV_PAYOUT_ALERT_EXPIRED_THRESHOLD=1
SHIPMENT_APV_PAYOUT_ALERT_APPROVAL_PENDING_THRESHOLD=1
SHIPMENT_APV_PAYOUT_ALERT_APPROVAL_MAX_AGE_MINUTES=15

ENABLE_DISPUTE_SIMILARITY_REVIEW_ALERT_JOB=false
DISPUTE_SIMILARITY_REVIEW_ALERT_URL=
DISPUTE_SIMILARITY_REVIEW_ALERT_SECRET=
DISPUTE_SIMILARITY_REVIEW_ALERT_TIMEOUT_MS=5000
DISPUTE_SIMILARITY_REVIEW_ALERT_COOLDOWN_MINUTES=15
DISPUTE_SIMILARITY_REVIEW_ALERT_OVERDUE_THRESHOLD=1
DISPUTE_SIMILARITY_REVIEW_ALERT_EXPIRED_THRESHOLD=1
DISPUTE_SIMILARITY_REVIEW_SLA_MINUTES=15
DISPUTE_SIMILARITY_REVIEW_DUE_SOON_MINUTES=60
ENABLE_DISPUTE_SIMILARITY_REVIEW_EXPIRY_JOB=false
DISPUTE_SIMILARITY_REVIEW_EXPIRY_BATCH_SIZE=50
ENABLE_DISPUTE_SIMILARITY_REVIEW_AUDIT_ARCHIVE_JOB=false
ENABLE_DISPUTE_AI_AUDIT_ARCHIVE_JOB=false
ENABLE_DISPUTE_EVIDENCE_PROVENANCE_ARCHIVE_JOB=false
ENABLE_DISPUTE_EVIDENCE_PROVENANCE_ARCHIVE_ALERT_JOB=false
DISPUTE_EVIDENCE_PROVENANCE_ARCHIVE_ALERT_URL=
DISPUTE_EVIDENCE_PROVENANCE_ARCHIVE_ALERT_SECRET=
# Signed aggregate alert for conditional-settlement config or live-chain failures. Requires ENABLE_CRON=true.
ENABLE_CONDITIONAL_SETTLEMENT_PREFLIGHT_ALERT_JOB=false
CONDITIONAL_SETTLEMENT_PREFLIGHT_ALERT_URL=
CONDITIONAL_SETTLEMENT_PREFLIGHT_ALERT_SECRET=
CONDITIONAL_SETTLEMENT_PREFLIGHT_ALERT_PREVIOUS_SECRETS=
# Must be no greater than WEBHOOK_EVENT_CLAIM_LEASE_SECONDS minus 5 seconds.
CONDITIONAL_SETTLEMENT_PREFLIGHT_ALERT_TIMEOUT_MS=5000
CONDITIONAL_SETTLEMENT_PREFLIGHT_ALERT_COOLDOWN_MINUTES=15
CONDITIONAL_SETTLEMENT_PREFLIGHT_ALERT_ALLOW_INSECURE_HTTP=false
CONDITIONAL_SETTLEMENT_PREFLIGHT_ALERT_ALLOW_PRIVATE_NETWORK=false
ENABLE_CONDITIONAL_SETTLEMENT_FINALITY_ALERT_JOB=false
CONDITIONAL_SETTLEMENT_FINALITY_ALERT_URL=
CONDITIONAL_SETTLEMENT_FINALITY_ALERT_SECRET=
# Receiver rotation: comma-separated previous secrets; current + previous total <= 4, each 16..128 chars, no duplicates.
CONDITIONAL_SETTLEMENT_FINALITY_ALERT_PREVIOUS_SECRETS=
CONDITIONAL_SETTLEMENT_FINALITY_ALERT_TIMEOUT_MS=5000
CONDITIONAL_SETTLEMENT_FINALITY_ALERT_COOLDOWN_MINUTES=15
CONDITIONAL_SETTLEMENT_FINALITY_ALERT_ALLOW_INSECURE_HTTP=false
CONDITIONAL_SETTLEMENT_FINALITY_ALERT_ALLOW_PRIVATE_NETWORK=false
DISPUTE_AI_AUDIT_ARCHIVE_MAX_EVENTS=10000
DISPUTE_AI_AUDIT_ARCHIVE_UNFINISHED_MAX_AGE_MINUTES=15
DISPUTE_AI_AUDIT_ARCHIVE_COVERAGE_MAX_AGE_MINUTES=15
DISPUTE_AUDIT_CURRENT_KEY_NOT_BEFORE=
DISPUTE_AUDIT_CURRENT_KEY_NOT_AFTER=
DISPUTE_AUDIT_TRUSTED_PUBLIC_KEYS_JSON=[]
ENABLE_DISPUTE_AI_AUDIT_ARCHIVE_ALERT_JOB=false
DISPUTE_AI_AUDIT_ARCHIVE_ALERT_URL=
DISPUTE_AI_AUDIT_ARCHIVE_ALERT_SECRET=
DISPUTE_AI_AUDIT_ARCHIVE_ALERT_PREVIOUS_SECRETS=
DISPUTE_AI_AUDIT_ARCHIVE_ALERT_TIMEOUT_MS=5000
DISPUTE_AI_AUDIT_ARCHIVE_ALERT_COOLDOWN_MINUTES=15
DISPUTE_AI_AUDIT_ARCHIVE_ALERT_STALE_THRESHOLD=1
DISPUTE_AI_AUDIT_ARCHIVE_ALERT_RETRY_READY_THRESHOLD=5
DISPUTE_AI_AUDIT_ARCHIVE_ALERT_DEAD_LETTER_THRESHOLD=1
DISPUTE_AI_AUDIT_ARCHIVE_ALERT_OVERDUE_UNFINISHED_THRESHOLD=1
DISPUTE_AI_AUDIT_ARCHIVE_ALERT_DISCOVERY_UNRESOLVED_THRESHOLD=1
DISPUTE_AI_AUDIT_ARCHIVE_ALERT_DISCOVERY_TOO_LARGE_THRESHOLD=1
DISPUTE_AI_AUDIT_ARCHIVE_ALERT_ALLOW_INSECURE_HTTP=false
DISPUTE_AI_AUDIT_ARCHIVE_ALERT_ALLOW_PRIVATE_NETWORK=false
ENABLE_DISPUTE_SIMILARITY_REVIEW_AUDIT_ARCHIVE_ALERT_JOB=false
DISPUTE_SIMILARITY_REVIEW_AUDIT_ARCHIVE_ALERT_URL=
DISPUTE_SIMILARITY_REVIEW_AUDIT_ARCHIVE_ALERT_SECRET=
DISPUTE_SIMILARITY_REVIEW_AUDIT_ARCHIVE_ALERT_PREVIOUS_SECRETS=
DISPUTE_SIMILARITY_REVIEW_AUDIT_ARCHIVE_ALERT_TIMEOUT_MS=5000
DISPUTE_SIMILARITY_REVIEW_AUDIT_ARCHIVE_ALERT_COOLDOWN_MINUTES=15
DISPUTE_SIMILARITY_REVIEW_AUDIT_ARCHIVE_ALERT_STALE_THRESHOLD=1
DISPUTE_SIMILARITY_REVIEW_AUDIT_ARCHIVE_ALERT_RETRY_READY_THRESHOLD=5
DISPUTE_SIMILARITY_REVIEW_AUDIT_ARCHIVE_ALERT_DEAD_LETTER_THRESHOLD=1
DISPUTE_SIMILARITY_REVIEW_AUDIT_ARCHIVE_ALERT_OVERDUE_UNFINISHED_THRESHOLD=1
DISPUTE_SIMILARITY_REVIEW_AUDIT_ARCHIVE_ALERT_ALLOW_INSECURE_HTTP=false
DISPUTE_SIMILARITY_REVIEW_AUDIT_ARCHIVE_ALERT_ALLOW_PRIVATE_NETWORK=false
ENABLE_SHIPMENT_APV_CANCELLATION_AUDIT_ARCHIVE_JOB=false
HAGGLE_AUDIT_ARCHIVE_UNFINISHED_MAX_AGE_MINUTES=15
ENABLE_SHIPMENT_APV_CANCELLATION_AUDIT_ARCHIVE_ALERT_JOB=false
HAGGLE_AUDIT_ARCHIVE_ALERT_URL=
HAGGLE_AUDIT_ARCHIVE_ALERT_SECRET=
HAGGLE_AUDIT_ARCHIVE_ALERT_TIMEOUT_MS=5000
HAGGLE_AUDIT_ARCHIVE_ALERT_COOLDOWN_MINUTES=15
HAGGLE_AUDIT_ARCHIVE_ALERT_STALE_THRESHOLD=1
HAGGLE_AUDIT_ARCHIVE_ALERT_RETRY_READY_THRESHOLD=5
HAGGLE_AUDIT_ARCHIVE_ALERT_DEAD_LETTER_THRESHOLD=1
HAGGLE_AUDIT_ARCHIVE_ALERT_OVERDUE_UNFINISHED_THRESHOLD=1
HAGGLE_AUDIT_ARCHIVE_ALERT_ALLOW_INSECURE_HTTP=false
HAGGLE_AUDIT_ARCHIVE_ALERT_ALLOW_PRIVATE_NETWORK=false
HAGGLE_AUDIT_ARCHIVE_URL=
HAGGLE_AUDIT_ARCHIVE_BEARER_TOKEN=
HAGGLE_AUDIT_ARCHIVE_TIMEOUT_MS=10000
HAGGLE_AUDIT_ARCHIVE_MAX_ATTEMPTS=10

# ─── Notifications (Resend) ──────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
NOTIFICATION_UNSUBSCRIBE_SECRET=
# Absolute private storage root for immutable EasyPost/APV invoice source documents.
SHIPMENT_INVOICE_DOCUMENT_ROOT=
ENABLE_SHIPMENT_APV_INVOICE_RESTORATION_MAINTENANCE_JOB=false
SHIPMENT_APV_INVOICE_RESTORATION_MAINTENANCE_ACTOR_ID=
SHIPMENT_APV_INVOICE_RESTORATION_MAINTENANCE_LIMIT=100
ENABLE_SHIPMENT_APV_INVOICE_RESTORATION_REMEDIATION_EXPIRY_JOB=false
SHIPMENT_APV_INVOICE_RESTORATION_REMEDIATION_EXPIRY_LIMIT=100
ENABLE_SHIPMENT_APV_REMEDIATION_CURSOR_RETENTION_JOB=false
SHIPMENT_APV_REMEDIATION_CURSOR_RETENTION_DAYS=30
SHIPMENT_APV_REMEDIATION_CURSOR_RETENTION_LIMIT=1000
